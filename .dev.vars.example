# 本地 cf:preview 用(wrangler 读 .dev.vars);生产用 `wrangler secret put <KEY>`。
# 复制为 .dev.vars 并填值(勿提交 .dev.vars)。
DATABASE_URL=            # Neon 连接串(必须 neon,queryCompiler+adapter-neon)
DIRECT_URL=             # Neon 直连串(迁移用,可同 DATABASE_URL)
NEXTAUTH_SECRET=        # openssl rand -base64 32
NEXTAUTH_URL=           # https://<worker子域或自定义域>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENROUTER_API_KEY=       # OpenRouter API key for text/image/video models
R2_ACCOUNT_ID=            # Required on Vercel for durable media storage; Cloudflare Workers can use MEDIA_BUCKET binding instead
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=instatok
STRIPE_SECRET_KEY=      # 不用 Stripe 可留空 + PAYMENT_PROVIDER=redeem
STRIPE_WEBHOOK_SECRET=
PAYMENT_PROVIDER=redeem
